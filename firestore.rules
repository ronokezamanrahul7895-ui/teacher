rules_version = '2';

/* THE version to actually deploy (project-level — applies to all four
   portals: Student, Teacher, Exam Committee, Admin Dashboard). Supersedes
   the drafts shipped inside the Student Portal and Teacher Portal zips —
   this one adds scriptMarks, resultPublishRequests and auditLogs on top
   of everything those two already covered.

   NO CLOUD FUNCTIONS, NO CUSTOM CLAIMS — every portal in this system runs
   on the client SDK only, so the whole Firebase project can stay on the
   Spark (free, no billing account) plan. Deploying even one Cloud
   Function forces a project onto Blaze (a linked card), regardless of
   whether it stays within the free quota. Custom claims can only ever be
   set by the Admin SDK, i.e. server-side, so they're not usable here
   either — role() below looks up which of admins/examCommittee/teachers/
   students actually contains the caller's uid instead of reading a claim.
   That costs a few extra document reads per rule evaluation (still well
   inside Spark's 50k reads/day for a school-sized project) in exchange
   for never needing Blaze.

   Permission hierarchy:
     - Accounts        -> can create/edit students/*, manage classes/enrollments/billing
     - Teacher         -> can edit/delete students/*
     - Exam Committee  -> can edit/delete students/* AND teachers/*
     - Admin           -> can edit/delete everything
     - Student         -> read-only on their own docs, never writes them
                          directly (all writes go through a portal acting
                          on their behalf, or their own create-only request
                          docs below)

   Anonymity chain enforced here (see each portal's README for the full
   story): examSeatAssignments -> answerScripts -> scriptMarks are all
   scriptId/seat-keyed and never carry a name. scriptIdentityMap is the
   one link, and only `admin` can ever read it.
*/

/* No custom claims (see header) — resolve role by checking which
   collection actually has a profile doc at the caller's uid. Order
   matters only for cost (most-privileged first would cost more reads for
   ordinary students, so students would ideally go first — but every
   `match` block below already gates its own collection first via
   isOwner(), so role() is only reached for the *other* collections,
   where checking admin/examCommittee/teacher before student is fine).
   Each exists() call here is cached per request by the rules engine, so
   calling role() more than once per request doesn't re-read anything. */
function role() {
  return
    exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ? 'admin' :
    exists(/databases/$(database)/documents/examCommittee/$(request.auth.uid)) ? 'examCommittee' :
    exists(/databases/$(database)/documents/accounts/$(request.auth.uid)) ? 'accounts' :
    exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ? 'teacher' :
    exists(/databases/$(database)/documents/students/$(request.auth.uid)) ? 'student' :
    null;
}

function isOwner(id) {
  return request.auth.uid == id;
}

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- Accounts / profiles ---------------- */

    match /students/{studentId} {
      allow read: if request.auth != null &&
        (isOwner(studentId) || role() in ['teacher', 'examCommittee', 'accounts', 'admin']);
      allow create, update: if request.auth != null && role() in ['teacher', 'examCommittee', 'accounts', 'admin'];
      /* Accounts can admit/edit students but never delete them. */
      allow delete: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
    }

    match /teachers/{teacherId} {
      allow read: if request.auth != null &&
        (isOwner(teacherId) || role() in ['examCommittee', 'admin']);
      allow write: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    /* Accounts Portal users (admission, classes, billing). Profile docs are
       created by an admin from the Admin Dashboard's Accounts page. */
    match /accounts/{uid} {
      allow read: if request.auth != null && (isOwner(uid) || role() == 'admin');
      allow write: if request.auth != null && role() == 'admin';
    }

    match /examCommittee/{memberId} {
      allow read: if request.auth != null && (isOwner(memberId) || role() == 'admin');
      allow write: if request.auth != null && role() == 'admin';
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && (isOwner(adminId) || role() == 'admin');
      /* Two ways to create an admin profile doc: (a) an existing admin
         adding another one from the Accounts page, or (b) the very first
         admin, self-creating their own doc via register.html — allowed
         only while system/bootstrap doesn't exist yet (see that match
         block below; the two creates happen together in one transaction
         in js/register.js). Path (b) closes itself off permanently the
         moment the first admin succeeds. */
      allow create: if request.auth != null &&
        (role() == 'admin' ||
         (isOwner(adminId) && !exists(/databases/$(database)/documents/system/bootstrap)));
      allow update, delete: if request.auth != null && role() == 'admin';
    }

    /* ---------------- Billing / admit card ---------------- */

    match /billing/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['examCommittee', 'accounts', 'admin']);
      allow create, update: if request.auth != null && role() in ['examCommittee', 'accounts', 'admin'];
      /* Financial records are never deleted by accounts staff (VOID instead). */
      allow delete: if request.auth != null && role() == 'admin';
    }

    /* ---------------- Academic years / classes / enrollments ---------------- */

    match /academicYears/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && role() in ['accounts', 'admin'];
    }
    match /classes/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && role() in ['accounts', 'admin'];
    }
    match /enrollments/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['teacher', 'examCommittee', 'accounts', 'admin']);
      allow write: if request.auth != null && role() in ['accounts', 'admin'];
    }

    match /admitCards/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['teacher', 'examCommittee', 'admin']);
      /* Spark-free path: Exam Committee Portal's Bill Create page
         (js/billing.js there) writes this directly once a bill's balance
         hits 0 for a trimester with a matching exam — no Cloud Function
         needed. Students never get write access here, so they still
         can't forge their own admit card; only examCommittee/admin can,
         and they already control `balance` directly, so this doesn't
         open a new attack surface. */
      allow write: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    /* ---------------- Exam-center check-in chain ---------------- */

    match /examSessions/{sessionId} {
      allow read: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
      allow write: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
    }

    match /examSeatAssignments/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['teacher', 'examCommittee', 'admin']);
      allow create, update: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
      allow delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /answerScripts/{scriptId} {
      /* Status moves ISSUED -> COLLECTED (Teacher) -> RECEIVED (Committee)
         -> MARKED. Never contains studentId or a name at any stage. */
      allow read: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
      allow create, update: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
      allow delete: if request.auth != null && role() == 'admin';
    }

    match /scriptIdentityMap/{scriptId} {
      /* THE secret mapping. Teacher/examCommittee CREATE it at check-in
         (physical ID check happens at their desk) but can never read it
         back. Only `admin` can read this collection — enforced here, not
         just by UI convention. */
      allow create: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
      allow read: if request.auth != null && role() == 'admin';
      allow update, delete: if request.auth != null && role() == 'admin';
    }

    match /scriptMarks/{scriptId} {
      /* Written by Exam Committee (Marks Entry), scriptId-keyed, never a
         name. `locked` gates further edits at the rules level too, not
         just in the UI — once locked, only admin can change it (e.g. to
         correct a mistake after the fact). */
      allow read: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
      allow create: if request.auth != null && role() in ['examCommittee', 'admin'];
      allow update: if request.auth != null &&
        (role() == 'admin' || (role() == 'examCommittee' && resource.data.locked != true));
      allow delete: if request.auth != null && role() == 'admin';
    }

    match /resultPublishRequests/{requestId} {
      allow read: if request.auth != null && role() in ['examCommittee', 'admin'];
      allow create: if request.auth != null && role() in ['examCommittee', 'admin'];
      /* Only admin approves/rejects (updates status). */
      allow update: if request.auth != null && role() == 'admin';
      allow delete: if request.auth != null && role() == 'admin';
    }

    match /auditLogs/{logId} {
      /* Written only by the Admin Dashboard, about actions the Admin
         Dashboard itself just took. */
      allow read: if request.auth != null && role() == 'admin';
      /* Accounts Portal logs its own actions (actorId must be the caller). */
      allow create: if request.auth != null &&
        (role() == 'admin' || (role() == 'accounts' && request.resource.data.actorId == request.auth.uid));
      allow update, delete: if false;
    }

    /* ---------------- Results ---------------- */

    match /results/{docId} {
      /* A student can only read their own result once it's published;
         staff can always read (they need to see it before publishing). */
      allow read: if request.auth != null &&
        (
          (docId.split('_')[0] == request.auth.uid && resource.data.published == true) ||
          role() in ['teacher', 'examCommittee', 'admin']
        );
      allow write: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    /* ---------------- Student-submitted request collections ---------------- */

    match /specialExamApplications/{appId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow update, delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /courseDrops/{dropId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow update, delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /semesterDrops/{dropId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow update, delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /programChangeRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow update, delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /transportRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow update, delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /preRegistrations/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow create, update: if request.auth != null &&
        docId.split('_')[0] == request.auth.uid && request.resource.data.studentId == request.auth.uid;
      allow delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /registrationConfirmations/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['examCommittee', 'admin']);
      allow create, update: if request.auth != null &&
        docId.split('_')[0] == request.auth.uid && request.resource.data.studentId == request.auth.uid;
      allow delete: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /courseEvaluations/{docId} {
      /* Anonymized feedback: once submitted, not even the student can
         edit or delete it. */
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['teacher', 'examCommittee', 'admin']);
      allow create: if request.auth != null &&
        docId.split('_')[0] == request.auth.uid && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------------- Reference / status collections ---------------- */

    match /classRoutine/{docId} {
      allow read: if request.auth != null &&
        (docId.split('_')[0] == request.auth.uid || role() in ['teacher', 'examCommittee', 'admin']);
      allow write: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
    }

    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && role() in ['examCommittee', 'admin'];
    }

    match /teamsCredentials/{studentId} {
      allow read: if request.auth != null && (isOwner(studentId) || role() in ['teacher', 'examCommittee', 'admin']);
      allow write: if request.auth != null && role() in ['teacher', 'examCommittee', 'admin'];
    }

    /* ---------------- System / bootstrap ---------------- */

    match /system/bootstrap {
      /* Client-created now (js/register.js), inside the same transaction
         that creates the first admins/{uid} doc. Any signed-in user may
         READ this (it only reveals "has any admin been created yet",
         nothing sensitive) and may attempt to CREATE it — but Firestore
         only ever invokes a `create` rule when the doc doesn't already
         exist; once the first registration succeeds, every later attempt
         is an `update` (no matching allow below → denied), which is what
         makes this one-time. No `update`/`delete` is ever granted, so
         once claimed this doc can never change or be removed by a
         client. */
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /system/{docId} {
      /* Every other system/* doc stays fully blocked from any client. */
      allow read, write: if false;
    }
  }
}
